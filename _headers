# Für alle Seiten: nicht in fremde Rahmen einbetten (Schutz vor Clickjacking), keine Typ-Raterei
/*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Adminboard: nur eigene Skripte, damit eingeschleuster Code das Admin-Token nicht lesen kann
/admin/*
  Content-Security-Policy: frame-ancestors 'none'; script-src 'self'; object-src 'none'; base-uri 'none'
